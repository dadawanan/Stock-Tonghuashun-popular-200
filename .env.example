# ── Database ──
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=stock_db
DB_USER=postgresql
DB_PASSWORD=your_password
DB_SSL=disable

# ── JWT ──
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── Test Database (optional) ──
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_NAME=
TEST_DB_USER=
TEST_DB_PASSWORD=

# ── Docker Compose ──
# 使用 docker-compose 时，DB_HOST 会自动设为 postgres 容器名
# DB_PASSWORD 会同时用于 PostgreSQL 和应用连接
COMPOSE_PROJECT_NAME=stock

# ── Agent Stock AI ──
# 开发环境：http://localhost:9002
# Docker 环境：http://agent-stock:9002
AGENT_STOCK_URL=http://localhost:9002

# ── Proxy (Tailscale + Clash Verge 反爬代理) ──
# 家庭电脑的 Tailscale IP（100.x.x.x 格式），为空则不使用代理
PROXY_HOST=
# Clash Verge 局域网共享端口，默认 7890
PROXY_PORT=7890
# 请求超时秒数
PROXY_TIMEOUT=30
# 随机延迟范围（秒），模拟人类操作间隔
PROXY_DELAY_MIN=0.3
PROXY_DELAY_MAX=1.2
